 "both": {
  "spec": {
   "name": "Day levels both ways",
   "timeframe": "5m",
   "direction": "both",
   "entry": {
    "long": {
     "all": [
      {
       "lhs": {
        "kind": "price",
        "field": "close"
       },
       "cmp": "crosses_above",
       "rhs": {
        "kind": "level",
        "name": "prev_day_high"
       }
      }
     ],
     "any": [
      {
       "lhs": {
        "kind": "indicator",
        "name": "macd",
        "output": "hist"
       },
       "cmp": "gt",
       "rhs": {
        "kind": "const",
        "value": 0
       }
      },
      {
       "lhs": {
        "kind": "indicator",
        "name": "ema_angle",
        "params": {
         "period": 9
        }
       },
       "cmp": "rising",
       "bars": 3
      }
     ]
    },
    "short": {
     "all": [
      {
       "lhs": {
        "kind": "change_pct",
        "ref": "session_open"
       },
       "cmp": "lte",
       "rhs": {
        "kind": "const",
        "value": -0.75
       }
      },
      {
       "lhs": {
        "kind": "price",
        "field": "close",
        "offset": 1
       },
       "cmp": "lt",
       "rhs": {
        "kind": "indicator",
        "name": "bbands",
        "params": {
         "period": 20,
         "stddev": 2.5
        },
        "output": "lower"
       }
      }
     ]
    }
   },
   "exit": {
    "short": {
     "any": [
      {
       "lhs": {
        "kind": "indicator",
        "name": "rsi"
       },
       "cmp": "falling"
      }
     ]
    }
   },
   "risk": {
    "stop": {
     "mode": "atr",
     "value": 1.5
    },
    "target": {
     "mode": "points",
     "value": 24350.55
    },
    "trail": {
     "mode": "breakeven_then_atr",
     "value": 2
    },
    "time_stop_bars": 12
   },
   "session": {
    "entry_start": "10:00",
    "entry_end": "14:45",
    "eod_squareoff": false,
    "squareoff_time": "15:15"
   },
   "sizing": {
    "lots": 3
   },
   "execution": {
    "slippage": "stress"
   }
